xt": " Never chase a lot, okay?", "tokens": [50727, 7236, 15505, 257, 1256, 11, 8788, 30, 50831], "temperature": 0.0, "avg_logprob": -0.11396499603025374, "compression_ratio": 1.6561264822134387, "no_speech_prob": 0.0003377694229129702}, {"id": 53, "seek": 23864, "start": 248.0, "end": 249.67999999999998, "text": " Never chase big risk reward ratios.", "tokens": [50831, 7236, 15505, 1263, 2526, 6721, 22423, 13, 50915], "temperature": 0.0, "avg_logprob": -0.11396499603025374, "compression_ratio": 1.6561264822134387, "no_speech_prob": 0.0003377694229129702}, {"id": 54, "seek": 23864, "start": 250.48, "end": 252.88, "text": " The price is going to come to you, all right?", "tokens": [50955, 383, 2756, 318, 1016, 284, 1282, 284, 345, 11, 477, 826, 30, 51075], "temperature": 0.0, "avg_logprob": -0.11396499603025374, "compression_ratio": 1.6561264822134387, "no_speech_prob": 0.0003377694229129702}, {"id": 55, "seek": 23864, "start": 253.6, "end": 255.04, "text": " The market is not yours.", "tokens": [51111, 383, 1910, 318, 407, 12431, 13, 51183], "temperature": 0.0, "avg_logprob": -0.11396499603025374, "compression_ratio": 1.6561264822134387, "no_speech_prob": 0.0003377694229129702}, {"id": 56, "seek": 23864, "start": 255.04, "end": 256.71999999999997, "text": " It can reverse anytime.", "tokens": [51183, 632, 460, 9575, 17949, 13, 51267], "temperature": 0.0, "avg_logprob": -0.11396499603025374, "compression_ratio": 1.6561264822134387, "no_speech_prob": 0.0003377694229129702}, {"id": 57, "seek": 23864, "start": 256.71999999999997, "end": 260.24, "text": " So why not just take your profits and enjoy the rest of the day,", "tokens": [51267, 1406, 1521, 407, 655, 1011, 534, 10177, 290, 2883, 262, 1334, 286, 262, 1110, 11, 51443], "temperature": 0.0, "avg_logprob": -0.11396499603025374, "compression_ratio": 1.6561264822134387, "no_speech_prob": 0.0003377694229129702}, {"id": 58, "seek": 23864, "start": 260.24, "end": 263.68, "text": " rather than holding the trade and expecting to hit like,", "tokens": [51443, 2138, 621, 4769, 262, 3292, 290, 12451, 284, 2277, 588, 11, 51615], "temperature": 0.0, "avg_logprob": -0.11396499603025374, "compression_ratio": 1.6561264822134387, "no_speech_prob": 0.0003377694229129702}, {"id": 59, "seek": 23864, "start": 263.68, "end": 266.24, "text": " I don't know, maybe 10 risk reward.", "tokens": [51615, 314, 836, 470, 760, 11, 3863, 838, 2526, 6721, 13, 51743], "temperature": 0.0, "avg_logprob": -0.11396499603025374, "compression_ratio": 1.6561264822134387, "no_speech_prob": 0.0003377694229129702}, {"id": 60, "seek": 26624, "start": 266.32, "end": 271.2, "text": " Yes, sometimes you can hit it, but it's just not worth it guys.", "tokens": [50367, 3363, 11, 3360, 345, 460, 2277, 340, 11, 475, 340, 338, 655, 407, 2861, 340, 3730, 13, 50611], "temperature": 0.0, "avg_logprob": -0.21504156406109148, "compression_ratio": 1.3384615384615384, "no_speech_prob": 0.0005250247777439654}, {"id": 61, "seek": 26624, "start": 271.2, "end": 273.52, "text": " So just take your profits and enjoy.", "tokens": [50611, 1406, 655, 1011, 534, 10177, 290, 2883, 13, 50727], "temperature": 0.0, "avg_logprob": -0.21504156406109148, "compression_ratio": 1.3384615384615384, "no_speech_prob": 0.0005250247777439654}, {"id": 62, "seek": 26624, "start": 274.56, "end": 279.44, "text": " So I'll give you an example of this reaction in your auto block.", "tokens": [50779, 1406, 314, 1183, 1577, 345, 281, 1672, 286, 428, 6317, 287, 534, 8295, 2512, 13, 51023], "temperature": 0.0, "avg_logprob": -0.21504156406109148, "compression_ratio": 1.3384615384615384, "no_speech_prob": 0.0005250247777439654}, {"id": 63, "seek": 26624, "start": 279.44, "end": 281.04, "text": " So yeah.", "tokens": [51023, 1406, 10194, 13, 51103], "temperature": 0.0, "avg_logprob": -0.21504156406109148, "compression_ratio": 1.3384615384615384, "no_speech_prob": 0.0005250247777439654}], "language": "en"}