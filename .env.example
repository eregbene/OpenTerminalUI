# ============================================================================
# Bensim Trading — single configuration file
# ----------------------------------------------------------------------------
# Copy this file to `.env` (the installer does this for you) and fill in keys.
#   cp .env.example .env
# Easiest way to add/update keys interactively:  make keys   (or ./scripts/setup-keys.sh)
#
# EVERYTHING IS OPTIONAL. The app boots and runs with built-in fallback data
# providers when no keys are present — add keys only to unlock live/full data.
# This one file is read by both the backend and Docker Compose. You do NOT
# need a separate backend/.env anymore.
# ============================================================================

# ----------------------------------------------------------------------------
# Security secrets  (auto-generated by ./install.sh — leave blank to let the
# installer fill them in with strong random values)
# ----------------------------------------------------------------------------
JWT_SECRET_KEY=
CACHE_SIGNING_KEY=

# ----------------------------------------------------------------------------
# First-run admin account  (auto-generated by ./install.sh)
# A unique admin account is seeded on first launch so you can log in
# immediately — no "user not found" errors. Credentials are printed at the
# end of the install. Change the password after first login.
# Seeding is skipped automatically once any user exists.
# ----------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=admin@openterminal.local
BOOTSTRAP_ADMIN_PASSWORD=

# ----------------------------------------------------------------------------
# Market data API keys  (all optional)
# ----------------------------------------------------------------------------
# Financial Modeling Prep — US equities, fundamentals, earnings
FMP_API_KEY=
# Finnhub — US real-time WebSocket ticks
FINNHUB_API_KEY=
FINNHUB_WS_ENABLED=true
# FRED — macro / economic series
FRED_API_KEY=
# Alpaca — US market data
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_FEED=iex
ALPACA_ADJUSTMENT=raw
# Zerodha Kite — India NSE/BSE real-time + historical
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# ----------------------------------------------------------------------------
# AI / LLM (optional — powers news sentiment & emotion analysis)
# ----------------------------------------------------------------------------
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_ANALYSIS_ENABLED=1
AI_TRADING_MODE=SHADOW
AI_ORDER_SUBMISSION_ENABLED=0
AI_MULTI_TRADE_VALIDATION_MODE=false
AI_TRADING_DAY_TIMEZONE=Europe/Bucharest
AI_ANALYSIS_INTERVAL_SECONDS=900
AI_REQUEST_TIMEOUT_SECONDS=30
AI_PROVIDER_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=0
AI_MIN_CONFIDENCE=0.70
AI_MIN_RISK_REWARD=1.5
PAPER_ACCOUNT_STARTING_BALANCE=1000000
PAPER_ACCOUNT_CURRENCY=USD
AI_MAX_RISK_PERCENT=0.05
AI_SYMBOL_ALLOWLIST=EURUSD
AI_TIMEFRAME_ALLOWLIST=15m
AI_ALLOWED_ORDER_TYPES=MARKET
AI_MAX_POSITION_SIZE_FOREX=100000
AI_MAX_OPEN_POSITIONS=3
AI_MAX_OPEN_ORDERS=9
AI_MAX_TRADES_PER_DAY=5
AI_MAX_TRADES_PER_SYMBOL_PER_DAY=3
AI_MAX_DAILY_LOSS_USD=1000
AI_MAX_TOTAL_OPEN_RISK_USD=600
FX_INSUFFICIENT_CASH_POLICY=REJECT
FX_MIN_ORDER_QUANTITY=1
FX_FUNDING_COMMISSION_BUFFER=2.50
FX_FUNDING_CASH_BUFFER=1.00
FX_FUNDING_SLIPPAGE_PIPS=0
FX_FOREX_LEVERAGE_PERMITTED=false
AUTO_FX_CONVERSION_FOR_TRADING=false
AI_MAX_TRADE_LOSS_USD=200
AI_MAX_CONSECUTIVE_LOSSES=3
AI_COOLDOWN_SECONDS=3600
AI_POST_TRADE_COOLDOWN_MINUTES=15
AI_MAX_SPREAD_BPS=8
AI_MAX_RETRIES=0
AI_MAX_PROVIDER_REQUESTS_PER_CYCLE=1
AI_MAX_PROVIDER_REQUESTS_PER_HOUR=2
AI_MAX_PROVIDER_REQUESTS_PER_DAY=10
AI_TARGET_MAX_INPUT_TOKENS=2500
AI_MAX_OUTPUT_TOKENS=250
AI_DAILY_COST_LIMIT_USD=0.10
AI_MONTHLY_COST_LIMIT_USD=4.50
AI_MAX_HOLDING_MINUTES=240
AI_SCHEDULER_ENABLED=0
AI_AUTONOMOUS_ACCEPTANCE_MAX_ENTRIES=1
AI_AUTONOMOUS_ACCEPTANCE_ENTRY_USED=0
AI_AUTONOMOUS_ACCEPTANCE_COMPLETE=0
AI_DAILY_ACCEPTANCE_MAX_ENTRIES=5
AI_DAILY_ACCEPTANCE_ENTRIES_USED=0
AI_DAILY_ACCEPTANCE_DATE=

# MetaTrader 5 Demo (read-only milestone)
MT5_ENABLED=false
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=MetaQuotes-Demo
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_TIMEOUT_MS=60000
MT5_PORTABLE=false
MT5_ACCOUNT_MODE=DEMO
MT5_LIVE_TRADING_ENABLED=false
MT5_ORDER_SUBMISSION_ENABLED=false
MT5_AUTONOMOUS_SUBMISSION_ENABLED=false
MT5_MANUAL_ACCEPTANCE_ENABLED=false
BROKER_PROVIDER=MT5
FOREX_EXECUTION_PROVIDER=MT5
MT5_MAX_NEW_ENTRIES_PER_CYCLE=1
MT5_SCHEDULER_OWNER=mt5-global
MT5_BENSIM_MAGIC=5601001
MT5_MAX_HOLDING_MINUTES=240
MT5_AUTONOMOUS_ROLLOUT_MAX_ENTRIES=0
MT5_AUTONOMOUS_ROLLOUT_COMPLETE=true
MT5_ROLLOUT_MAX_LOTS=
MT5_ROLLOUT_MAX_OPEN_POSITIONS=
MT5_BRIDGE_HOST=127.0.0.1
MT5_BRIDGE_PORT=8765
MT5_BRIDGE_API_KEY=
MT5_CALENDAR_EXPORT_FILE=
MT5_FOREX_UNIVERSE_MODE=ALL_AVAILABLE
MT5_INCLUDE_MAJORS=true
MT5_INCLUDE_MINORS=true
MT5_INCLUDE_EXOTICS=true
MT5_INCLUDE_METALS=true
MT5_EXCLUDED_SYMBOLS=
MT5_EXCLUDED_CURRENCIES=
MT5_EXCLUDED_GROUP_PATTERNS=
MT5_TRADING_SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,USDCHF,NZDUSD,EURJPY,GBPJPY,XAUUSD
MT5_MAX_AI_CANDIDATES_PER_CYCLE=1
MT5_BLOCK_ON_CONTEXT_WARNINGS=false
MT5_BLOCK_ON_CALENDAR_UNAVAILABLE=false
MT5_MAX_TRADES_PER_DAY=20
MT5_MAX_TRADES_PER_SYMBOL_PER_DAY=3
MT5_MAX_OPEN_POSITIONS=5
MT5_MAX_TOTAL_OPEN_ORDERS=15
MT5_MAX_CONSECUTIVE_LOSSES=5
MT5_POST_TRADE_COOLDOWN_MINUTES=15
MT5_RISK_PERCENT_PER_TRADE=0.25
MT5_INTERNAL_MAX_DAILY_LOSS_PERCENT=1.50
MT5_INTERNAL_MAX_TOTAL_DRAWDOWN_PERCENT=5.00
MT5_MAX_TOTAL_OPEN_RISK_PERCENT=1.00
MT5_MAX_RISK_PER_TRADE_USD=250
MT5_MAX_DAILY_LOSS_USD=1500
MT5_MAX_TOTAL_OPEN_RISK_USD=1000
MT5_MAX_POSITIONS_PER_BASE_CURRENCY=3
MT5_MAX_POSITIONS_PER_QUOTE_CURRENCY=3
MT5_MAX_CORRELATED_POSITIONS=3
MT5_ALLOW_OPPOSING_SAME_SYMBOL_POSITIONS=false
MT5_MAX_POSITIONS_PER_SYMBOL=1
PROP_PROFILE=GENERIC_PROP_CONSERVATIVE
MT5_REQUEST_TIMEOUT_MS=60000
MT5_DEFAULT_HISTORY_COUNT=100
DECISION_CONTEXT_ENABLED=true
MT5_CALENDAR_ENABLED=true
MT5_CALENDAR_REFRESH_SECONDS=60
MT5_CALENDAR_LOOKAHEAD_DAYS=14
MT5_CALENDAR_HISTORY_DAYS=30
MT5_CALENDAR_STALE_AFTER_SECONDS=180
MT5_CALENDAR_STRICT_MODE=false
GDELT_ENABLED=true
GDELT_REFRESH_INTERVAL_SECONDS=300
GDELT_REQUEST_TIMEOUT_SECONDS=20
GDELT_MAX_RESULTS_PER_QUERY=50
ALPHA_VANTAGE_ENABLED=true
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_REQUEST_TIMEOUT_SECONDS=15
ALPHA_VANTAGE_REFRESH_INTERVAL_SECONDS=900
FRED_ENABLED=true
FRED_API_KEY=
FRED_REQUEST_TIMEOUT_SECONDS=15
FRED_REFRESH_INTERVAL_SECONDS=21600
CONTEXT_NEWS_STALE_AFTER_MINUTES=60
CONTEXT_NEWS_DEDUP_WINDOW_HOURS=72
CONTEXT_RETENTION_DAYS=730
CALENDAR_HIGH_IMPACT_PRE_BLOCK_MINUTES=30
CALENDAR_HIGH_IMPACT_POST_BLOCK_MINUTES=15
CALENDAR_MEDIUM_IMPACT_PRE_WARNING_MINUTES=20
CALENDAR_MEDIUM_IMPACT_POST_WARNING_MINUTES=10
NEWS_HIGH_RISK_BLOCK_ENABLED=true
NEWS_ELEVATED_RISK_ACK_REQUIRED=false
CONTEXT_STRICT_MODE=false
# Forex Factory economic-intelligence layer (backend/economic_intelligence) -- separate
# from the decision_context block above; MT5 calendar there is unrelated to this one.
FF_CALENDAR_ENABLED=true
FF_NEWS_ENABLED=true
FF_EVENT_DETAIL_ENABLED=true
FF_WEEKLY_JSON_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
FF_CALENDAR_REFRESH_SECONDS=300
FF_RELEASE_POLL_SECONDS=60
FF_NEWS_REFRESH_SECONDS=300
FF_EVENT_DETAIL_STALE_DAYS=30
FF_REQUEST_TIMEOUT_SECONDS=20
FF_MAX_RETRIES=3
FF_BACKFILL_DELAY_SECONDS=3
FF_BACKFILL_MAX_MONTHS_PER_RUN=3
FF_PROVIDER_FAIL_MODE=conservative
FF_HIGH_IMPACT_BLOCK_BEFORE_MINUTES=30
FF_HIGH_IMPACT_DELAY_AFTER_MINUTES=15
FF_MEDIUM_IMPACT_BLOCK_BEFORE_MINUTES=15
FF_MEDIUM_IMPACT_DELAY_AFTER_MINUTES=5
FF_CENTRAL_BANK_BLOCK_BEFORE_MINUTES=60
FF_CENTRAL_BANK_DELAY_AFTER_MINUTES=30
FF_REQUIRE_SPREAD_NORMALIZATION=true
FF_REQUIRE_POST_EVENT_CLOSED_CANDLES=1
FF_OPENAI_MACRO_CLASSIFICATION_ENABLED=true
FF_OPENAI_MIN_CONFIDENCE=0.65
OLLAMA_BASE_URL=http://localhost:11434
# OpenRouter — powers the in-app agent console AND news emotion analysis
# (key starts with sk-or-...).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Agent / emotion LLM routing. AGENT_PROVIDER: openrouter | openai | lmstudio | gemini.
# AGENT_MODEL: an OpenRouter model id (use a :free model for the free tier) or a gemini model (e.g. gemini-2.0-flash).
# AGENT_FALLBACK_MODELS: comma-separated fallback models tried in order when the
# primary is rate-limited (429) or unavailable (404). Keep all entries ":free" if using openrouter free tier.
GEMINI_API_KEY=
AGENT_PROVIDER=openrouter
AGENT_MODEL=openai/gpt-oss-20b:free
AGENT_FALLBACK_MODELS=openai/gpt-oss-20b:free,qwen/qwen3-coder:free,meta-llama/llama-3.3-70b-instruct:free
# AGENT_DEBATE_ENABLED: enable multi-agent debate mode (analyst team -> bull/bear
# -> portfolio manager). The Agent console exposes a "Debate" toggle; set this to
# true so that toggle works. Debate runs several LLM calls per request.
AGENT_DEBATE_ENABLED=true
# LM Studio (locally hosted Gemma model). Start LM Studio, load a Gemma model,
# enable its local server, then set LM_STUDIO_ENABLED=true.
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=google/gemma-4-26b-a4b
LM_STUDIO_ENABLED=true

# ----------------------------------------------------------------------------
# Infrastructure / runtime (sensible defaults — usually no need to change)
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Docker Compose uses the Redis service hostname by default. Override only if needed.
DOCKER_REDIS_URL=redis://redis:6379/0
# New Bensim aliases are preferred by the backend. Legacy OPENTERMINALUI_* names
# remain supported for existing deployments and scripts.
BENSIM_ENV=development
BENSIM_SQLITE_URL=sqlite:///data/openterminalui.db
BENSIM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
BENSIM_PREFETCH_ENABLED=0
BENSIM_REDIS_KEY_PREFIX=bensim
OPENTERMINALUI_SQLITE_URL=sqlite:///data/openterminalui.db
OPENTERMINALUI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
OPENTERMINALUI_PREFETCH_ENABLED=0
CHART_CACHE_TTL=900
OHLCV_HOT_TTL_SECONDS=300
OHLCV_WARM_TTL_SECONDS=86400
OHLCV_COLD_ROOT=data/bars
